{
  "name": "@transomjs/transom-scaffold",
  "version": "6.0.0",
  "description": "Serve static assets and add redirect routes to a Transom REST API (Express compatible).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "deploy": "np",
    "test": "cross-env NODE_ENV=testing c8 mocha",
    "cover": "c8 report --reporter=html && open-cli ./coverage/index.html",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transomjs/transom-scaffold.git"
  },
  "keywords": [
    "TransomJS",
    "static content",
    "assets",
    "redirect routes"
  ],
  "author": "Mark Voorberg <mark@binaryops.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/transomjs/transom-scaffold/issues"
  },
  "homepage": "https://github.com/transomjs/transom-scaffold#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@transomjs/transom-core": "^7.0.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "express": "^4.21.1",
    "mocha": "^12.0.3",
    "np": "^12.1.1",
    "open-cli": "^9.0.0",
    "pocket-registry": "^3.0.0",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@transomjs/transom-core": "^5.0.1"
  },
  "dependencies": {
    "@types/express": "^4.17.25"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "lib",
    "CHANGELOG.md"
  ]
}
